# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Alibaba Cloud DashScope API key (for the qwen / qwen-omni providers)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Comma-separated vxasr configuration ids, in retry order (optional).
# Defaults to qwen-omni/qwen3.5-omni-flash-realtime-2026-03-15
#ASR_CONFIGURATIONS=qwen-omni/qwen3.5-omni-flash-realtime-2026-03-15,qwen/qwen3-asr-flash-realtime-2026-02-10

# --- Utterance segmentation (all in milliseconds) ---
# Silence within the audio that ends an utterance. Raise it to join short
# sentences, so the model gets more context in one turn.
#SILENCE_DURATION=1500
# No audio arriving at all (mute, disconnect, stall). Keep above SILENCE_DURATION.
#STALL_TIMEOUT_MS=2000
# How long Discord keeps a speaker's stream open. The ceiling on the two above.
#RECEIVER_SILENCE_MS=2500
# Longest a single utterance may run before it is split and a new one continues.
# Guards against audio that never pauses (music, a television, a noisy room).
#MAX_UTTERANCE_MS=120000

# --- Vendor session reuse (qwen-omni only) ---
# Reuse a speaker's connection so the model keeps the previous turn's context.
# Better on short sentences, but the vendor re-bills prior turns as context.
# Set to 0 for a fresh connection per utterance.
#ASR_SESSION_REUSE=1
# Audio a reused connection may accumulate before it is retired. Default 100.
#QWEN_OMNI_STICKY_MAX_AUDIO_SECONDS=100
# How long an idle connection waits for the speaker's next utterance. Default 30000.
#QWEN_OMNI_STICKY_LINGER_MS=30000

# Logging level (1=error, 2=warn, 3=log, 4=info, 5=debug)
#LOG_LEVEL=4
